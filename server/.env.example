# Copy this file to .env and change the values before going live.

# Port the API listens on
PORT=4000

# Secret used to sign JWT tokens — CHANGE THIS to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Default Super Admin (created on first run / seed)
ADMIN_EMAIL=thandi@mobsie.co.za
ADMIN_PASSWORD=admin123

# Default password given to seeded parent accounts (mobile app logins)
PARENT_PASSWORD=parent123

# Comma-separated list of allowed CORS origins, or * for any (fine in dev)
CORS_ORIGIN=*
